# /etc/systemd/system/gitm-slack-direct.service
[Unit]
Description=gitm off-scheduler GPU use -> Slack (this node)
After=network-online.target
Wants=network-online.target
[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/gitm-slack-notify direct --interval 30
Restart=always
RestartSec=15
[Install]
WantedBy=multi-user.target
